		ExpandHint: 按住 Shift 查看属性
	}

	PWingTesseract: {
		DisplayName: 超立方体
		Tooltip:
			'''
			召唤虚空分身使用物品攻击敌人
			从物品栏左下角槽位开始到右下角槽位结束，每个分身使用不同的物品
			首次召唤时，分身会等待命令以确定如何使用物品（左键或右键）以及持续时间（充能物品）
			物品首次使用后，分身将按照指定方式自动使用物品
			分身使用的物品受虚空和召唤伤害加成影响，但伤害会降低30%（乘法计算）
			'''
	}

	WorldMagnet: {
