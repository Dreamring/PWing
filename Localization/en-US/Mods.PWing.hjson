Items: {
	PWingAzafureMiner: {
		DisplayName: Azafure Digital Miner
		Tooltip: An intelligent device that automatically mines and filters ores
	}

	GildedBladeWings: {
		DisplayName: Dream Ring
		Tooltip: This Dream Ring is not of this world, but born from the realm of fantasy
		Lore1: This Dream Ring is not of this world, but born from the realm of fantasy
		Lore2: It follows its master through every battle, growing stronger together
		Lore3: Each demon slain deepens its power, until it becomes a divine artifact
		FlightTime: Flight Time: {0}s
		FlightSpeed: Flight Speed: {0}
		BossKills: Enlightenment: {0}
		LifeBonus: Life +{0}
		EnduranceBonus: Damage Reduction +{0}%
		DefenseBonus: Defense +{0}
		AttackBonus: Damage +{0}%
		LifeRegenBonus: Life Regen +{0}
		ManaBonus: Mana +{0}
		SlotBonus: Minion Slots +{0}
		GrowthHint: Awaiting its first awakening, seeking demons to slay
		NextGrowth: Next: {0}s · {1} speed
	}

	PWingTesseract: {
		DisplayName: P Wing Tesseract
		Tooltip:
			'''
			Summons void clones that attack enemies with items
			Starting from the bottom-left inventory slot to the bottom-right, each clone uses a different item
			On first summon, clones wait for your command to decide how to use the item (left or right click) and the duration (charged items)
			After the first use, clones will keep using the item automatically in the chosen way
			Clone item damage scales with void and summon damage bonuses, but is reduced by 30% (multiplicative)
			'''
	}
}

SlotInfo2: Insert Raw Ore
AzMinerOreWarning: Only ore items can be placed in filter slots!

Buffs: {
	PWingTesseractBuff: {
		DisplayName: P Wing Tesseract
		Description: You are everywhere, you have everything, you are always present
	}
}

Projectiles: {
	PWingTesseractLaser.DisplayName: P Wing Tesseract Laser
	PWingTesseractServant.DisplayName: P Wing Tesseract Servant
}

Configs: {
	PWingConfig: {
		DisplayName: PWing Mod Configuration

		lowFidelityMode: {
			Label: Low Fidelity Mode
			Tooltip: Enable low-fidelity rendering mode to improve game performance. Visual effects will be reduced.
		}

		azafureMinerWhitelistEnabled: {
			Label: Miner Whitelist
			Tooltip: Enable to add additional ores or items to the miner's whitelist
		}

		azafureMinerWhitelistItems: {
			Label: Miner Whitelist Items
			Tooltip: Add additional ores or items to the miner whitelist for blocks that cannot be matched by general conditions
		}

		tesseractGlowIntensity: {
			Label: Glow Intensity
			Tooltip: Glow intensity of the Tesseract summoned minions. Higher values produce more pronounced glow effects.
		}

		tesseractLineThickness: {
			Label: Line Thickness
			Tooltip: Line thickness of the Tesseract summoned minion's cube structure.
		}

		tesseractColorSaturation: {
			Label: Color Saturation
			Tooltip: Color saturation of the Tesseract summoned minions. Higher values produce more vivid colors.
		}

		tesseractAnimationSpeed: {
			Label: Animation Speed
			Tooltip: Rotation and animation speed multiplier for the Tesseract summoned minions.
		}

		tesseractShowPlanetTexture: {
			Label: Show Planet Texture
			Tooltip: Whether to display the planet texture at the center of the summoned minion.
		}

		tesseractShowWings: {
			Label: Show Wings
			Tooltip: Whether to display the wing effects of the summoned minion.
		}

		tesseractShowWeapon: {
			Label: Show Weapon
			Tooltip: Whether to display the weapon texture held by the summoned minion.
		}

		Headers: {
			WingConfigs: Wing Configs
			AzafureMinerConfigs: Azafure Miner Configs
			TesseractConfigs: Tesseract Configuration
		}
	}
}
